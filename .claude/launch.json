{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "console",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "uvicorn",
        "services.console.app:create_app",
        "--factory",
        "--port",
        "8765",
        "--timeout-graceful-shutdown",
        "3"
      ],
      "port": 8765
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "jupyter",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--group",
        "notebooks",
        "jupyter",
        "lab",
        "--no-browser",
        "--port",
        "8888",
        "--IdentityProvider.token=tessera",
        "--ServerApp.root_dir=.",
        "--ServerApp.open_browser=False"
      ],
      "port": 8888
    }
  ]
}
