# Copy to .env only in local development. Production values come from Vault.
# Every key here must be documented in docs/config.md.
#
# Agents (and humans) may edit THIS file freely. The real .env is protected by
# .claude/hooks/protect_secrets.py and cannot be read or written by either.

# --- core -------------------------------------------------------------------
DATABASE_URL=postgresql://tessera:<password>@localhost:5432/tessera

# --- card processing (PCI scope) --------------------------------------------
CARD_PROCESSOR_API_KEY=sk_live_<from-vault:tessera/card-processor>
CARD_PROCESSOR_WEBHOOK_SECRET=whsec_<from-vault:tessera/card-processor>

# --- ledger -----------------------------------------------------------------
LEDGER_SIGNING_KEY=<from-vault:tessera/ledger-signing>

# --- risk -------------------------------------------------------------------
FRAUD_MODEL_ENDPOINT=https://fraud-model.internal.tessera.test/v2/score
FRAUD_MODEL_TOKEN=<from-vault:tessera/fraud-model>

# --- kyc --------------------------------------------------------------------
KYC_PROVIDER_API_KEY=<from-vault:tessera/kyc>

# --- observability ----------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.internal.tessera.test:4317
