+"""
+Fixtures for the gate tests.
+
+Two data sources, deliberately: a small synthetic table written once per
+session for the fast tests, and the checked-in table for the handful of tests
+that assert the numbers from the TESS-2310 investigation still reproduce.
+"""
+
+from __future__ import annotations
+
+from pathlib import Path
+
+import pandas as pd
+import pytest
+
+from ml.data.generate import generate
+from ml.validation.dataset import DEFAULT_DATA, load_transactions
+
+SMALL_ROWS = 20_000
+
+
+@pytest.fixture(scope="session")
+def small_data_path(tmp_path_factory: pytest.TempPathFactory) -> Path:
+    """A small synthetic table on disk, for exercising the gates' CLIs."""
+    path = tmp_path_factory.mktemp("validation-data") / "transactions.parquet"
+    generate(SMALL_ROWS).to_parquet(path, index=False)
+    return path
+
+
+@pytest.fixture(scope="session")
+def small_data(small_data_path: Path) -> pd.DataFrame:
+    return load_transactions(small_data_path)
+
+
+@pytest.fixture(scope="session")
+def repo_data() -> pd.DataFrame:
+    """The table the shadow investigation ran on."""
+    if not DEFAULT_DATA.exists() and not DEFAULT_DATA.with_suffix(".csv").exists():
+        pytest.skip("ml/data/transactions.parquet not generated")
+    return load_transactions()
diff --git a/ml/validation/tests/negative_fixtures.py b/ml/validation/tests/negative_fixtures.py
new file mode 100644
index 0000000..50058c9
--- /dev/null
+++ b/ml/validation/tests/negative_fixtures.py
@@ -0,0 +1,56 @@
+"""
+Known-bad feature definitions, kept so the gates can be shown to catch them.
+
+**Nothing in this module may be imported by anything outside
+`ml/validation/tests/`.** These are negative fixtures: a gate that cannot fail
+has not been tested, and the cheapest way to keep Gate 1 honest is to keep the
+exact definition that got past everyone the first time.
+
+`card_chargeback_rate_whole_table` is `ml/notebooks/01_fraud_exploration.ipynb`
+cell 8, unchanged apart from the `as_of` parameter it has to accept in order
+to be checked at all -- which it then ignores, because ignoring the as-of cut
+is the entire defect. On the synthetic table it is non-zero for 27.43% of
+training rows against the point-in-time feature's 3.44%, and it bought +0.128
+AUC offline that turned into -0.079 against the champion in shadow
+(TESS-2310).
+"""
+
+from __future__ import annotations
+
+import pandas as pd
+
+from ml.validation.leakage import FeatureUnderTest
+
+NOTEBOOK_SOURCE = "ml/notebooks/01_fraud_exploration.ipynb, cell 8"
+
+
+def card_chargeback_rate_whole_table(df: pd.DataFrame, as_of: object = None) -> pd.Series:
+    """
+    LEAKY. The whole-table chargeback rate per card, with no as-of cut.
+
+    Every row is handed every chargeback on its card, including the ones filed
+    after it and the one filed against it. Since `chargeback_filed_at` is
+    non-null on fraud rows and nowhere else, this is the label with a
+    behavioural-sounding name.
+    """
+    per_card = df.groupby("card_token")["chargeback_filed_at"].apply(lambda s: s.notna().mean())
+    return df["card_token"].map(per_card).fillna(0.0).rename("card_chargeback_rate")
+
+
+def reads_the_label(df: pd.DataFrame) -> pd.Series:
+    """LEAKY, and not subtly: the label itself, as a float."""
+    return df["is_fraud"].astype(float).rename("reads_the_label")
+
+
+LEAKY_AGGREGATES = {"card_chargeback_rate": card_chargeback_rate_whole_table}
+
+
+def notebook_feature_set() -> tuple[FeatureUnderTest, ...]:
+    """The v3 candidate as notebook 01 defined it -- what Gate 1 must reject."""
+    return (
+        FeatureUnderTest(
+            name="card_chargeback_rate",
+            compute=lambda frame: card_chargeback_rate_whole_table(frame, frame["timestamp"]),
+            historical=True,
+        ),
+    )
