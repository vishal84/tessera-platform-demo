index 0000000..3ea4216
--- /dev/null
+++ b/ml/validation/dataset.py
@@ -0,0 +1,81 @@
+"""
+Loading and splitting, shared by all four gates.
+
+One temporal split, defined once. Every gate reports against the same windows
+so their numbers can be read side by side: train on the first 70% of the
+timeline, evaluate on the last 30% -- which is the window the fraud-v3 shadow
+run scored (2026-07-05 to 2026-08-27).
+"""
+
+from __future__ import annotations
+
+import argparse
+from dataclasses import dataclass
+from pathlib import Path
+
+import pandas as pd
+
+ROOT = Path(__file__).resolve().parents[2]
+DEFAULT_DATA = ROOT / "ml" / "data" / "transactions.parquet"
+
+# Temporal, never random. Fraud is non-stationary and a random split flatters
+# everything -- it also hides exactly the failure Gate 1 looks for.
+SPLIT_QUANTILE = 0.70
+
+TIME_COLUMNS = ("timestamp", "chargeback_filed_at")
+LABEL = "is_fraud"
+
+
+@dataclass(frozen=True)
+class Split:
+    """A temporal split: everything up to `cut` trains, everything after scores."""
+
+    train: pd.DataFrame
+    test: pd.DataFrame
+    cut: pd.Timestamp
+
+    @property
+    def window(self) -> str:
+        return f"{self.test['timestamp'].min().date()} -> {self.test['timestamp'].max().date()}"
+
+
+def load_transactions(path: Path | str | None = None) -> pd.DataFrame:
+    """
+    Load the transaction table, sorted by time with a fresh index.
+
+    Synthetic throughout -- `ml/data/generate.py` is the only source of data in
+    this repository. `generate.py` falls back to CSV when pyarrow is missing,
+    so accept either.
+    """
+    path = Path(path) if path is not None else DEFAULT_DATA
+    if not path.exists() and path.suffix == ".parquet" and path.with_suffix(".csv").exists():
+        path = path.with_suffix(".csv")
+    if not path.exists():
+        raise FileNotFoundError(
+            f"{path} not found -- run `uv run python -m ml.data.generate` first"
+        )
+
+    df = pd.read_csv(path) if path.suffix == ".csv" else pd.read_parquet(path)
+    for column in TIME_COLUMNS:
+        if column in df.columns:
+            df[column] = pd.to_datetime(df[column], utc=True)
+    return df.sort_values("timestamp", kind="stable").reset_index(drop=True)
+
+
+def temporal_split(df: pd.DataFrame, quantile: float = SPLIT_QUANTILE) -> Split:
+    cut = df["timestamp"].quantile(quantile)
+    return Split(
+        train=df[df["timestamp"] <= cut].copy(),
+        test=df[df["timestamp"] > cut].copy(),
+        cut=cut,
+    )
+
+
+def add_data_argument(parser: argparse.ArgumentParser) -> None:
+    """`--data` on every gate, so a gate can be pointed at a fixture."""
+    parser.add_argument(
+        "--data",
+        type=Path,
+        default=None,
+        help=f"transaction table to validate (default: {DEFAULT_DATA.relative_to(ROOT)})",
+    )
