+"""
+The four gates every change to `ml/` passes before it can merge.
+
+    uv run python -m ml.validation.leakage     --fail-on-leak
+    uv run python -m ml.validation.performance --min-pr-auc 0.15
+    uv run python -m ml.validation.drift       --max-psi 0.25
+    uv run python -m ml.validation.fairness    --report fairness.md
+
+The contract lives in `.github/workflows/model-validation.yml`; these modules
+implement it (TESS-2310). Each gate is a module with a `run()` that returns a
+result object and a `main()` that prints a report and returns an exit status,
+so the same logic is callable from a test and from CI.
+
+Gate 1 is the one that matters most and the reason the other three exist: a
+feature that uses information unavailable at scoring time invalidates every
+number downstream of it, including gates 2, 3 and 4.
+"""
diff --git a/ml/validation/candidate.py b/ml/validation/candidate.py
new file mode 100644
index 0000000..b7e4e00
--- /dev/null
+++ b/ml/validation/candidate.py
@@ -0,0 +1,56 @@
+"""
+The model under validation: fraud-v3, point-in-time.
+
+This is the one definition of "the candidate" that gates 1, 2, 3 and 4 all
+read, so a feature cannot be validated in one shape and measured in another --
+which is precisely how fraud-v3 got to shadow (trained on a whole-table
+`card_chargeback_rate`, served a point-in-time one, TESS-2310).
+
+Feature construction has one rule that is easy to get backwards: **build on
+the whole frame, then split.** The aggregates are point-in-time, so a scored
+row correctly sees the history that precedes it -- including rows from the
+training window, exactly as the nightly `card_history` batch does in
+production. Splitting first would hand scored rows an empty history and
+understate the feature.
+"""
+
+from __future__ import annotations
+
+import numpy as np
+import pandas as pd
+from sklearn.ensemble import HistGradientBoostingClassifier
+
+from ml.features import aggregates, base
+from ml.validation.dataset import LABEL
+
+# Matches ml/notebooks/01_fraud_exploration.ipynb so the numbers stay
+# comparable to the recorded champion and shadow runs. Deterministic.
+MODEL_PARAMS = {"max_iter": 250, "random_state": 0}
+
+FEATURE_ORDER: tuple[str, ...] = (*base.BASE_FEATURES, *aggregates.AGGREGATE_FEATURES)
+
+
+def build_features(df: pd.DataFrame) -> pd.DataFrame:
+    """
+    The candidate's feature matrix, each row as of its own scoring instant.
+
+    Pass the *whole* history frame; slice the result afterwards.
+    """
+    frame = base.build(df)
+    for name, column in aggregates.build(df, df["timestamp"]).items():
+        frame[name] = column
+    return frame[list(FEATURE_ORDER)]
+
+
+def fit(features: pd.DataFrame, labels: pd.Series) -> HistGradientBoostingClassifier:
+    return HistGradientBoostingClassifier(**MODEL_PARAMS).fit(features, labels)
+
+
+def fit_on_split(features: pd.DataFrame, df: pd.DataFrame, train_index: pd.Index):
+    """Fit on the training rows of an already-built feature matrix."""
+    return fit(features.loc[train_index], df.loc[train_index, LABEL])
+
+
+def score(model: HistGradientBoostingClassifier, features: pd.DataFrame) -> np.ndarray:
+    """P(fraud) for each row."""
+    return model.predict_proba(features)[:, 1]
