index 0000000..327866b
--- /dev/null
+++ b/ml/validation/fairness.py
@@ -0,0 +1,345 @@
+"""
+Gate 4 -- fairness, reported per slice.
+
+    uv run python -m ml.validation.fairness --report fairness.md
+
+Aggregate metrics hide the thing MRM asks about. A model can hold PR-AUC
+steady while declining a quarter of one country's traffic, so every number
+here is reported per slice at a fixed review budget: the top 1% of scores,
+which is what an alert queue actually costs.
+
+Tessera holds no protected-class attributes on a transaction, and this
+repository holds no cardholder data at all, so nothing below is a
+protected-class measurement. The slices are the proxies available on the
+authorization record -- geography, cross-border status, merchant category
+risk, ticket size and time of day. Geography and ticket size are the ones that
+correlate with protected characteristics in the literature, so they are the
+ones to read first. A real adverse-impact analysis needs attributes we
+deliberately do not hold, and is done by Compliance on their side.
+
+The gate reports by default and blocks only when `--max-disparity` is given,
+so the team can tighten it without changing the CI contract.
+"""
+
+from __future__ import annotations
+
+import argparse
+from dataclasses import dataclass
+from datetime import UTC, datetime
+from pathlib import Path
+
+import numpy as np
+import pandas as pd
+from sklearn.metrics import average_precision_score
+
+from ml.features.base import MCC_RISK_TIER
+from ml.validation import candidate
+from ml.validation.dataset import LABEL, ROOT, add_data_argument, load_transactions, temporal_split
+
+# Share of the scored window sent to manual review. The operating point has to
+# be fixed for slice comparisons to mean anything.
+REVIEW_BUDGET = 0.01
+
+# Below this a slice's rates are noise; it is still listed, with metrics
+# blanked, because a slice too small to measure is itself worth seeing.
+MIN_SLICE = 200
+
+DEFAULT_REPORT = Path("fairness.md")
+
+
+@dataclass(frozen=True)
+class SliceMetrics:
+    dimension: str
+    slice: str
+    n: int
+    frauds: int
+    fraud_rate: float
+    alert_rate: float
+    tpr: float | None
+    fpr: float | None
+    precision: float | None
+    pr_auc: float | None
+
+    @property
+    def measurable(self) -> bool:
+        return self.n >= MIN_SLICE and self.frauds > 0
+
+
+@dataclass(frozen=True)
+class Disparity:
+    dimension: str
+    ratio: float
+    high: str
+    high_rate: float
+    low: str
+    low_rate: float
+
+
+@dataclass(frozen=True)
+class FairnessReport:
+    slices: tuple[SliceMetrics, ...]
+    disparities: tuple[Disparity, ...]
+    threshold: float
+    window: str
+    n_scored: int
+    fraud_rate: float
+    data_path: str
+    max_disparity: float | None
+
+    @property
+    def worst(self) -> Disparity | None:
+        return max(self.disparities, key=lambda d: d.ratio, default=None)
+
+    @property
+    def passed(self) -> bool:
+        if self.max_disparity is None:
+            return True
+        return all(d.ratio <= self.max_disparity for d in self.disparities)
+
+
+def slice_definitions(df: pd.DataFrame, train: pd.DataFrame) -> dict[str, pd.Series]:
+    """Slice labels for the scored rows. Amount bands come from the training window."""
+    edges = train["amount_minor"].quantile([0.25, 0.50, 0.75]).to_numpy()
+    band_labels = np.array(
+        [
+            f"Q1 <= ${edges[0] / 100:,.0f}",
+            f"Q2 ${edges[0] / 100:,.0f}-${edges[1] / 100:,.0f}",
+            f"Q3 ${edges[1] / 100:,.0f}-${edges[2] / 100:,.0f}",
+            f"Q4 > ${edges[2] / 100:,.0f}",
+        ]
+    )
+    hour = df["timestamp"].dt.hour
+
+    return {
+        "geography": df["country"].astype(str),
+        "cross_border": df["is_cross_border"].map({0: "domestic", 1: "cross-border"}),
+        "mcc_risk_tier": "tier " + df["mcc"].map(MCC_RISK_TIER).fillna(3).astype(int).astype(str),
+        "amount_band": pd.Series(
+            band_labels[np.searchsorted(edges, df["amount_minor"].to_numpy(), side="left")],
+            index=df.index,
+        ),
+        "time_of_day": pd.Series(
+            np.where((hour >= 1) & (hour <= 5), "night 01-05", "day 06-00"), index=df.index
+        ),
+    }
+
+
+def _metrics(
+    dimension: str, name: str, labels: pd.Series, scores: np.ndarray, flagged: np.ndarray
+) -> SliceMetrics:
+    truth = labels.to_numpy(dtype=int)
+    frauds = int(truth.sum())
+    genuine = int((truth == 0).sum())
+    alerts = int(flagged.sum())
+
+    measurable = len(truth) >= MIN_SLICE and frauds > 0
+    return SliceMetrics(
+        dimension=dimension,
+        slice=name,
+        n=len(truth),
+        frauds=frauds,
+        fraud_rate=float(truth.mean()) if len(truth) else 0.0,
+        alert_rate=alerts / len(truth) if len(truth) else 0.0,
+        tpr=float(flagged[truth == 1].mean()) if measurable else None,
+        fpr=float(flagged[truth == 0].mean()) if measurable and genuine else None,
+        precision=float(truth[flagged].mean()) if measurable and alerts else None,
+        pr_auc=(
+            float(average_precision_score(truth, scores)) if measurable and genuine else None
+        ),
+    )
+
+
+def _disparity(dimension: str, slices: list[SliceMetrics]) -> Disparity | None:
+    """Alert-rate spread across a dimension, over slices big enough to mean something."""
+    usable = [s for s in slices if s.n >= MIN_SLICE and s.alert_rate > 0]
+    if len(usable) < 2:
+        return None
+
+    high = max(usable, key=lambda s: s.alert_rate)
+    low = min(usable, key=lambda s: s.alert_rate)
+    return Disparity(
+        dimension=dimension,
+        ratio=high.alert_rate / low.alert_rate,
+        high=high.slice,
+        high_rate=high.alert_rate,
+        low=low.slice,
+        low_rate=low.alert_rate,
+    )
+
+
+def run(
+    df: pd.DataFrame,
+    max_disparity: float | None = None,
+    review_budget: float = REVIEW_BUDGET,
+    data_path: str = "",
+) -> FairnessReport:
+    features = candidate.build_features(df)
+    split = temporal_split(df)
+
+    model = candidate.fit_on_split(features, df, split.train.index)
+    scored = split.test
+    scores = candidate.score(model, features.loc[scored.index])
+    threshold = float(np.quantile(scores, 1.0 - review_budget))
+    flagged = scores >= threshold
+
+    slices: list[SliceMetrics] = []
+    disparities: list[Disparity] = []
+    for dimension, labels in slice_definitions(scored, split.train).items():
+        values = labels.to_numpy()
+        measured = []
+        for name in sorted(pd.unique(values), key=str):
+            mask = values == name
+            measured.append(
+                _metrics(
+                    dimension, str(name), scored.loc[mask, LABEL], scores[mask], flagged[mask]
+                )
+            )
+        slices.extend(measured)
+        spread = _disparity(dimension, measured)
+        if spread is not None:
+            disparities.append(spread)
+
+    return FairnessReport(
+        slices=tuple(slices),
+        disparities=tuple(disparities),
+        threshold=threshold,
+        window=split.window,
+        n_scored=len(scored),
+        fraud_rate=float(scored[LABEL].mean()),
+        data_path=data_path,
+        max_disparity=max_disparity,
+    )
+
+
+def _cell(value: float | None, as_percent: bool = True) -> str:
+    if value is None:
+        return "n/a"
+    return f"{value:.2%}" if as_percent else f"{value:.4f}"
+
+
+def format_markdown(report: FairnessReport) -> str:
+    generated = datetime.now(UTC).strftime("%Y-%m-%d %H:%M UTC")
+    lines = [
+        "# Fairness slice report -- fraud-v3 (point-in-time)",
+        "",
+        f"Generated {generated} by `ml/validation/fairness.py` (Gate 4).",
+        "",
+        f"- Data: `{report.data_path or 'synthetic transactions'}` -- synthetic throughout, "
+        "no cardholder data.",
+        f"- Scored window: {report.window}, {report.n_scored:,} transactions, "
+        f"{report.fraud_rate:.2%} fraud.",
+        f"- Operating point: top {REVIEW_BUDGET:.1%} of scores flagged for review "
+        f"(threshold {report.threshold:.4f}).",
+        f"- Slices smaller than {MIN_SLICE} rows, or with no fraud in them, are listed "
+        "with metrics blanked rather than dropped.",
+        "",
+        "Tessera holds no protected-class attributes on a transaction. The slices below are "
+        "proxies available on the authorization record; geography and ticket size are the ones "
+        "that correlate with protected characteristics, so read those first. A statutory "
+        "adverse-impact analysis needs attributes we deliberately do not hold and is run by "
+        "Compliance separately.",
+        "",
+        "## Alert-rate disparity by dimension",
+        "",
+        "| dimension | ratio | highest | rate | lowest | rate |",
+        "|---|---:|---|---:|---|---:|",
+    ]
+    for d in sorted(report.disparities, key=lambda d: d.ratio, reverse=True):
+        lines.append(
+            f"| {d.dimension} | {d.ratio:.2f}x | {d.high} | {d.high_rate:.2%} | "
+            f"{d.low} | {d.low_rate:.2%} |"
+        )
+
+    for dimension in dict.fromkeys(s.dimension for s in report.slices):
+        lines += [
+            "",
+            f"## {dimension}",
+            "",
+            "| slice | n | fraud rate | alert rate | TPR | FPR | precision | PR-AUC |",
+            "|---|---:|---:|---:|---:|---:|---:|---:|",
+        ]
+        for s in (s for s in report.slices if s.dimension == dimension):
+            lines.append(
+                f"| {s.slice} | {s.n:,} | {s.fraud_rate:.2%} | {s.alert_rate:.2%} | "
+                f"{_cell(s.tpr)} | {_cell(s.fpr)} | {_cell(s.precision)} | "
+                f"{_cell(s.pr_auc, as_percent=False)} |"
+            )
+
+    lines += [
+        "",
+        "## Reading this",
+        "",
+        "A slice whose alert rate is far above its fraud rate is being over-reviewed: the "
+        "queue spends its budget there and the cardholders in it absorb the friction. A slice "
+        "whose TPR is far below the others is being under-protected. Both are findings even "
+        "when aggregate PR-AUC is healthy, which is the whole reason this gate reports per "
+        "slice.",
+        "",
+    ]
+    return "\n".join(lines)
+
+
+def format_summary(report: FairnessReport) -> str:
+    lines = [
+        "Gate 4 -- fairness slices",
+        f"  scored window: {report.window}  ({report.n_scored:,} rows)",
+        f"  operating point: top {REVIEW_BUDGET:.1%} of scores (threshold {report.threshold:.4f})",
+        f"  slices measured: {len(report.slices)} across {len(report.disparities)} dimensions",
+        "",
+    ]
+    for d in sorted(report.disparities, key=lambda d: d.ratio, reverse=True):
+        lines.append(
+            f"  {d.dimension:<16} alert-rate spread {d.ratio:.2f}x  "
+            f"({d.high} {d.high_rate:.2%} vs {d.low} {d.low_rate:.2%})"
+        )
+
+    lines.append("")
+    if report.max_disparity is None:
+        lines.append("  PASS -- report-only gate (pass --max-disparity to make it blocking).")
+    elif report.passed:
+        lines.append(f"  PASS -- every dimension within {report.max_disparity:.2f}x.")
+    else:
+        over = [d for d in report.disparities if d.ratio > report.max_disparity]
+        lines.append(
+            f"  FAIL -- {', '.join(f'{d.dimension} {d.ratio:.2f}x' for d in over)} "
+            f"above {report.max_disparity:.2f}x."
+        )
+    return "\n".join(lines)
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description="Gate 4: fairness slice report.")
+    add_data_argument(parser)
+    parser.add_argument(
+        "--report",
+        type=Path,
+        default=DEFAULT_REPORT,
+        help=f"markdown report to write (default {DEFAULT_REPORT})",
+    )
+    parser.add_argument(
+        "--max-disparity",
+        type=float,
+        default=None,
+        help="fail when any dimension's alert-rate ratio exceeds this (default: report only)",
+    )
+    args = parser.parse_args(argv)
+
+    data = args.data if args.data is not None else None
+    df = load_transactions(data)
+    shown = str(data) if data else str((ROOT / "ml/data/transactions.parquet").relative_to(ROOT))
+    report = run(df, max_disparity=args.max_disparity, data_path=shown)
+
+    args.report.parent.mkdir(parents=True, exist_ok=True)
+    args.report.write_text(format_markdown(report), encoding="utf-8")
+    print(format_summary(report))
+    print(f"\n  report written to {args.report}")
+
+    if not report.passed:
+        worst = report.worst
+        print(f"\n::error::alert-rate disparity {worst.ratio:.2f}x on {worst.dimension}")
+        return 1
+    return 0
+
+
+if __name__ == "__main__":  # pragma: no cover
+    raise SystemExit(main())
diff --git a/ml/validation/leakage.py b/ml/validation/leakage.py
new file mode 100644
index 0000000..52b44e5
--- /dev/null
+++ b/ml/validation/leakage.py
@@ -0,0 +1,282 @@
+"""
+Gate 1 -- point-in-time correctness.
+
+    uv run python -m ml.validation.leakage --fail-on-leak
+
+A feature is point-in-time correct when its value for a row depends only on
+what was knowable when that row was scored. That is a property you can test by
+*taking the future away* and checking the answer does not move:
+
+1. **label permutation** -- shuffle `is_fraud`. Any feature whose values move
+   is reading the label.
+2. **outcome censoring** -- hide chargebacks filed on or after the cutoff, the
+   way reality hides them (disputes land 20-89 days late, median 54). Any
+   feature whose values move for rows *before* the cutoff was being told the
+   answer by a dispute that had not been filed yet.
+3. **future rows** -- delete every transaction from the cutoff onwards. Any
+   historical aggregate whose values move for the surviving rows was
+   averaging over its own future.
+
+Check 2 is the one that catches the failure this gate was written for.
+Notebook 01's `card_chargeback_rate` is a whole-table
+`groupby(...).notna().mean()`: censoring chargebacks moves 27% of training
+rows, because it was never a behavioural signal at all -- `chargeback_filed_at`
+is non-null on fraud rows and nowhere else. Offline that bought +0.128 AUC;
+shadow gave it all back and more (TESS-2310). The point-in-time
+implementation in `ml/features/aggregates.py` is invariant under all three.
+
+Check 3 is run against historical aggregates only. `ml/features/base.py` is
+row-wise by construction with one documented exception,
+`amount_zscore_within_mcc`, which standardises against a whole-frame mean and
+standard deviation. It touches no outcome column, so it is not leakage in the
+sense this gate exists to catch, but it is frame-dependent and the gate says
+so rather than quietly passing it. Before v3 ships those two moments should be
+fit on the training window and frozen.
+"""
+
+from __future__ import annotations
+
+import argparse
+from collections.abc import Callable
+from dataclasses import dataclass
+
+import numpy as np
+import pandas as pd
+
+from ml.features import aggregates, base
+from ml.validation.dataset import LABEL, add_data_argument, load_transactions, temporal_split
+
+TOLERANCE = 1e-12
+PERMUTATION_SEED = 20262310
+
+# Frame-level statistics of observable fields. Documented in base.py, excluded
+# from the future-rows check by name so the exclusion is visible in the report
+# rather than buried in a predicate.
+FRAME_STATISTICS = ("amount_zscore_within_mcc",)
+
+
+@dataclass(frozen=True)
+class FeatureUnderTest:
+    """A feature bound to a frame, ready to be recomputed under censoring."""
+
+    name: str
+    compute: Callable[[pd.DataFrame], pd.Series]
+    historical: bool
+
+
+@dataclass(frozen=True)
+class CheckResult:
+    feature: str
+    check: str
+    leaked: bool
+    rows_compared: int
+    rows_changed: int
+    max_abs_diff: float
+    detail: str
+
+
+@dataclass(frozen=True)
+class LeakageReport:
+    cut: pd.Timestamp
+    results: tuple[CheckResult, ...]
+    exempt_from_future_rows: tuple[str, ...]
+
+    @property
+    def leaks(self) -> tuple[CheckResult, ...]:
+        return tuple(r for r in self.results if r.leaked)
+
+    @property
+    def clean(self) -> bool:
+        return not self.leaks
+
+
+def production_features() -> tuple[FeatureUnderTest, ...]:
+    """Every feature a fraud-v3 training table is built from."""
+    row_wise = [
+        FeatureUnderTest(name, fn, historical=False) for name, fn in base.BASE_FEATURES.items()
+    ]
+    historical = [
+        FeatureUnderTest(name, _as_of_own_timestamp(fn), historical=True)
+        for name, fn in aggregates.AGGREGATE_FEATURES.items()
+    ]
+    return (*row_wise, *historical)
+
+
+def _as_of_own_timestamp(fn: Callable[..., pd.Series]) -> Callable[[pd.DataFrame], pd.Series]:
+    """Bind an aggregate to the training convention: each row as of its own scoring instant."""
+    return lambda frame: fn(frame, frame["timestamp"])
+
+
+def _difference(
+    reference: pd.Series, recomputed: pd.Series, rows: pd.Index
+) -> tuple[int, float]:
+    """Rows whose value moved, and by how much, over `rows`."""
+    left = reference.loc[rows].to_numpy(dtype=float)
+    right = recomputed.loc[rows].to_numpy(dtype=float)
+    both_missing = np.isnan(left) & np.isnan(right)
+    delta = np.where(both_missing, 0.0, np.abs(np.nan_to_num(left) - np.nan_to_num(right)))
+    changed = delta > TOLERANCE
+    return int(changed.sum()), float(delta.max()) if delta.size else 0.0
+
+
+def _result(
+    feature: str, check: str, reference: pd.Series, recomputed: pd.Series, rows: pd.Index, why: str
+) -> CheckResult:
+    changed, worst = _difference(reference, recomputed, rows)
+    detail = (
+        f"{changed:,} of {len(rows):,} rows move when {why} (max |delta| {worst:.6f})"
+        if changed
+        else f"unchanged across {len(rows):,} rows when {why}"
+    )
+    return CheckResult(
+        feature=feature,
+        check=check,
+        leaked=changed > 0,
+        rows_compared=len(rows),
+        rows_changed=changed,
+        max_abs_diff=worst,
+        detail=detail,
+    )
+
+
+def _permuted_labels(df: pd.DataFrame) -> pd.DataFrame:
+    permuted = df.copy()
+    rng = np.random.default_rng(PERMUTATION_SEED)
+    permuted[LABEL] = rng.permutation(permuted[LABEL].to_numpy())
+    return permuted
+
+
+def _censored_outcomes(df: pd.DataFrame, cut: pd.Timestamp) -> pd.DataFrame:
+    """The frame as it looked at `cut`: disputes not yet filed are not yet known."""
+    censored = df.copy()
+    not_yet_filed = censored["chargeback_filed_at"] >= cut
+    censored.loc[not_yet_filed, "chargeback_filed_at"] = pd.NaT
+    return censored
+
+
+def check_feature(feature: FeatureUnderTest, df: pd.DataFrame, cut: pd.Timestamp) -> list[CheckResult]:
+    """Run every applicable check against one feature."""
+    reference = feature.compute(df)
+    observable = df.index[df["timestamp"] <= cut]
+    results: list[CheckResult] = []
+
+    if LABEL in df.columns:
+        results.append(
+            _result(
+                feature.name,
+                "label_permutation",
+                reference,
+                feature.compute(_permuted_labels(df)),
+                df.index,
+                f"{LABEL} is permuted",
+            )
+        )
+
+    if "chargeback_filed_at" in df.columns:
+        results.append(
+            _result(
+                feature.name,
+                "outcome_censoring",
+                reference,
+                feature.compute(_censored_outcomes(df, cut)),
+                observable,
+                f"chargebacks filed on or after {cut.date()} are censored",
+            )
+        )
+
+    if feature.historical:
+        truncated = df.loc[observable]
+        results.append(
+            _result(
+                feature.name,
+                "future_rows",
+                reference,
+                feature.compute(truncated),
+                observable,
+                f"transactions from {cut.date()} onwards are deleted",
+            )
+        )
+
+    return results
+
+
+def run(
+    df: pd.DataFrame,
+    cut: pd.Timestamp | None = None,
+    features: tuple[FeatureUnderTest, ...] | None = None,
+) -> LeakageReport:
+    """Check every feature. `cut` defaults to the shared temporal split point."""
+    features = production_features() if features is None else features
+    cut = temporal_split(df).cut if cut is None else cut
+
+    results: list[CheckResult] = []
+    for feature in features:
+        try:
+            results.extend(check_feature(feature, df, cut))
+        except Exception as exc:  # a feature that cannot be recomputed cannot be cleared
+            results.append(
+                CheckResult(
+                    feature=feature.name,
+                    check="recompute",
+                    leaked=True,
+                    rows_compared=len(df),
+                    rows_changed=len(df),
+                    max_abs_diff=float("nan"),
+                    detail=f"raised {type(exc).__name__}: {exc}",
+                )
+            )
+
+    exempt = tuple(f.name for f in features if not f.historical and f.name in FRAME_STATISTICS)
+    return LeakageReport(cut=cut, results=tuple(results), exempt_from_future_rows=exempt)
+
+
+def format_report(report: LeakageReport) -> str:
+    lines = [
+        "Gate 1 -- point-in-time correctness",
+        f"  cutoff: {report.cut.isoformat()}",
+        "",
+        f"  {'feature':<28} {'check':<20} {'verdict':<8} detail",
+    ]
+    for result in report.results:
+        verdict = "LEAK" if result.leaked else "ok"
+        lines.append(f"  {result.feature:<28} {result.check:<20} {verdict:<8} {result.detail}")
+
+    if report.exempt_from_future_rows:
+        lines += [
+            "",
+            "  not checked for future-row sensitivity (whole-frame statistics of "
+            "observable fields, no outcome columns read):",
+            f"    {', '.join(report.exempt_from_future_rows)}",
+            "    -- fit these moments on the training window and freeze them before v3 ships.",
+        ]
+
+    lines.append("")
+    if report.clean:
+        lines.append(f"  PASS -- {len(report.results)} checks, no feature moved.")
+    else:
+        lines.append(f"  FAIL -- {len(report.leaks)} of {len(report.results)} checks found leakage:")
+        lines += [f"    {r.feature}: {r.check}" for r in report.leaks]
+    return "\n".join(lines)
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description="Gate 1: point-in-time correctness.")
+    add_data_argument(parser)
+    parser.add_argument(
+        "--fail-on-leak",
+        action="store_true",
+        help="exit non-zero when any feature depends on information from after it was scored",
+    )
+    args = parser.parse_args(argv)
+
+    report = run(load_transactions(args.data))
+    print(format_report(report))
+
+    if report.leaks and args.fail_on_leak:
+        print("\n::error::point-in-time violation -- every number downstream of this is invalid")
+        return 1
+    return 0
+
+
+if __name__ == "__main__":  # pragma: no cover
+    raise SystemExit(main())
diff --git a/ml/validation/performance.py b/ml/validation/performance.py
new file mode 100644
index 0000000..be3d1ad
--- /dev/null
+++ b/ml/validation/performance.py
@@ -0,0 +1,112 @@
+"""
+Gate 2 -- performance floor on a temporal split.
+
+    uv run python -m ml.validation.performance --min-pr-auc 0.15
+
+PR-AUC, not AUC. Fraud is a 3.5%-prevalence problem; ROC-AUC is dominated by
+the majority class and moves far too little when a model's precision collapses
+in the alert queue. The floor is the champion's recorded PR-AUC on the same
+window, minus a small tolerance -- a candidate below it is not a candidate.
+
+The floor is deliberately low relative to fraud-v3's *offline* 0.358, because
+0.358 was leakage. The honest point-in-time number for the same feature set is
+0.16, and the gate exists to stop anything that only clears the bar by knowing
+the future: Gate 1 runs first and the two are read together -- a big number
+here plus a leak there means the number is fiction, which is exactly what the
+shadow run found (TESS-2310).
+"""
+
+from __future__ import annotations
+
+import argparse
+from dataclasses import dataclass
+
+import pandas as pd
+from sklearn.metrics import average_precision_score, roc_auc_score
+
+from ml.validation import candidate
+from ml.validation.dataset import LABEL, add_data_argument, load_transactions, temporal_split
+
+# fraud-v2 in production on the 2026-07-05 -> 2026-08-27 window.
+CHAMPION_PR_AUC = 0.164
+CHAMPION_AUC = 0.7782
+
+DEFAULT_MIN_PR_AUC = 0.15
+
+
+@dataclass(frozen=True)
+class PerformanceReport:
+    pr_auc: float
+    auc: float
+    n_train: int
+    n_test: int
+    fraud_rate_test: float
+    window: str
+    minimum: float
+
+    @property
+    def passed(self) -> bool:
+        return self.pr_auc >= self.minimum
+
+
+def run(df: pd.DataFrame, minimum: float = DEFAULT_MIN_PR_AUC) -> PerformanceReport:
+    features = candidate.build_features(df)
+    split = temporal_split(df)
+
+    model = candidate.fit_on_split(features, df, split.train.index)
+    scores = candidate.score(model, features.loc[split.test.index])
+    labels = split.test[LABEL]
+
+    return PerformanceReport(
+        pr_auc=float(average_precision_score(labels, scores)),
+        auc=float(roc_auc_score(labels, scores)),
+        n_train=len(split.train),
+        n_test=len(split.test),
+        fraud_rate_test=float(labels.mean()),
+        window=split.window,
+        minimum=minimum,
+    )
+
+
+def format_report(report: PerformanceReport) -> str:
+    verdict = "PASS" if report.passed else "FAIL"
+    return "\n".join(
+        [
+            "Gate 2 -- performance floor",
+            f"  scored window : {report.window}  "
+            f"({report.n_test:,} rows, {report.fraud_rate_test:.2%} fraud)",
+            f"  trained on    : {report.n_train:,} rows",
+            f"  PR-AUC        : {report.pr_auc:.4f}   (floor {report.minimum:.4f}, "
+            f"champion {CHAMPION_PR_AUC:.4f})",
+            f"  ROC-AUC       : {report.auc:.4f}   (champion {CHAMPION_AUC:.4f})",
+            "",
+            f"  {verdict} -- PR-AUC {report.pr_auc:.4f} "
+            f"{'>=' if report.passed else '<'} {report.minimum:.4f}",
+        ]
+    )
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description="Gate 2: performance floor on a temporal split.")
+    add_data_argument(parser)
+    parser.add_argument(
+        "--min-pr-auc",
+        type=float,
+        default=DEFAULT_MIN_PR_AUC,
+        help=f"PR-AUC the candidate must clear on the scored window (default {DEFAULT_MIN_PR_AUC})",
+    )
+    args = parser.parse_args(argv)
+
+    report = run(load_transactions(args.data), minimum=args.min_pr_auc)
+    print(format_report(report))
+
+    if not report.passed:
+        print(
+            f"\n::error::PR-AUC {report.pr_auc:.4f} is below the floor {report.minimum:.4f}"
+        )
+        return 1
+    return 0
+
+
+if __name__ == "__main__":  # pragma: no cover
+    raise SystemExit(main())
