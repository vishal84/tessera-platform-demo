@@ -0,0 +1,138 @@
+"""
+Tests for the point-in-time aggregates.
+
+The property under test is always the same one: a value may only depend on
+what had already happened at `as_of`. Each test below removes something from
+the future and asserts the answer did not move.
+"""
+
+import numpy as np
+import pandas as pd
+import pytest
+
+from ml.features.aggregates import build, card_chargeback_rate
+
+
+@pytest.fixture
+def history() -> pd.DataFrame:
+    """
+    One card with a late dispute, one card with none.
+
+    tok_a's first transaction is disputed, but the chargeback is not filed
+    until 2026-02-10 -- so it is invisible to the 2026-02-01 transaction and
+    visible to the 2026-03-01 one.
+    """
+    return pd.DataFrame(
+        {
+            "transaction_id": ["txn_1", "txn_2", "txn_3", "txn_4"],
+            "card_token": ["tok_a", "tok_a", "tok_a", "tok_b"],
+            "timestamp": pd.to_datetime(
+                ["2026-01-01T00:00:00Z", "2026-02-01T00:00:00Z", "2026-03-01T00:00:00Z",
+                 "2026-01-15T00:00:00Z"]
+            ),
+            "chargeback_filed_at": pd.to_datetime(
+                ["2026-02-10T00:00:00Z", None, None, None]
+            ),
+            "amount_minor": [1_000, 2_000, 3_000, 4_000],
+        }
+    )
+
+
+def test_a_row_never_counts_its_own_chargeback(history):
+    """The notebook's bug, stated as a test: txn_1 is disputed and scores 0.0."""
+    rate = card_chargeback_rate(history, history["timestamp"])
+    assert rate.iloc[0] == 0.0
+
+
+def test_a_dispute_is_invisible_until_it_is_filed(history):
+    rate = card_chargeback_rate(history, history["timestamp"])
+    # txn_2: one prior transaction, its chargeback not yet filed.
+    assert rate.iloc[1] == 0.0
+    # txn_3: two prior transactions, one of them disputed by now.
+    assert rate.iloc[2] == pytest.approx(0.5)
+
+
+def test_a_card_with_no_history_scores_zero(history):
+    rate = card_chargeback_rate(history, history["timestamp"])
+    assert rate.iloc[3] == 0.0
+
+
+def test_cards_do_not_bleed_into_each_other(history):
+    """tok_b sits between two disputed tok_a rows in time and stays clean."""
+    rate = card_chargeback_rate(history, pd.Timestamp("2026-06-01T00:00:00Z"))
+    assert rate[history.card_token == "tok_a"].tolist() == [pytest.approx(1 / 3)] * 3
+    assert rate[history.card_token == "tok_b"].tolist() == [0.0]
+
+
+def test_scalar_as_of_applies_one_cutoff_to_every_row(history):
+    """How the nightly batch serves it: one refresh time for the whole batch."""
+    rate = card_chargeback_rate(history, "2026-02-15T00:00:00Z")
+    # tok_a by 2026-02-15: two transactions have happened, one is disputed.
+    assert rate[history.card_token == "tok_a"].tolist() == [pytest.approx(0.5)] * 3
+
+
+def test_the_bound_is_strict(history):
+    """A chargeback filed at exactly `as_of` is not yet observable at `as_of`."""
+    assert card_chargeback_rate(history, "2026-02-10T00:00:00Z").max() == 0.0
+    assert card_chargeback_rate(history, "2026-02-10T00:00:01Z").max() > 0.0
+
+
+def test_result_does_not_depend_on_row_order(history):
+    ordered = card_chargeback_rate(history, history["timestamp"])
+    shuffled = history.iloc[[2, 0, 3, 1]]
+    reordered = card_chargeback_rate(shuffled, shuffled["timestamp"])
+    pd.testing.assert_series_equal(reordered.sort_index(), ordered)
+
+
+def test_tied_timestamps_do_not_count_each_other(history):
+    """Two transactions at the same instant are each other's future, not past."""
+    tied = history.copy()
+    tied.loc[2, "timestamp"] = tied.loc[1, "timestamp"]
+    rate = card_chargeback_rate(tied, tied["timestamp"])
+    assert rate.iloc[1] == rate.iloc[2] == 0.0
+
+
+def test_dropping_future_rows_changes_nothing(history):
+    """Gate 1's future-rows check, at unit scale."""
+    full = card_chargeback_rate(history, history["timestamp"])
+    early = history[history["timestamp"] <= "2026-02-01T00:00:00Z"]
+    truncated = card_chargeback_rate(early, early["timestamp"])
+    pd.testing.assert_series_equal(truncated, full.loc[early.index])
+
+
+def test_rate_stays_within_zero_and_one(history):
+    rate = card_chargeback_rate(history, history["timestamp"])
+    assert rate.between(0.0, 1.0).all()
+
+
+def test_as_of_is_required():
+    with pytest.raises(TypeError):
+        card_chargeback_rate(pd.DataFrame())  # type: ignore[call-arg]
+
+
+def test_mismatched_as_of_length_is_rejected(history):
+    with pytest.raises(ValueError, match="one instant per row"):
+        card_chargeback_rate(history, history["timestamp"].iloc[:2])
+
+
+def test_missing_as_of_is_rejected(history):
+    with pytest.raises(ValueError, match="NaT"):
+        card_chargeback_rate(history, pd.Series([pd.NaT] * len(history)))
+
+
+def test_a_frame_without_dispute_history_is_rejected(history):
+    with pytest.raises(ValueError, match="chargeback_filed_at"):
+        card_chargeback_rate(history.drop(columns=["chargeback_filed_at"]), "2026-06-01T00:00:00Z")
+
+
+def test_empty_frame_returns_an_empty_column(history):
+    rate = card_chargeback_rate(history.iloc[:0], "2026-06-01T00:00:00Z")
+    assert rate.empty
+    assert rate.name == "card_chargeback_rate"
+
+
+def test_build_returns_every_registered_aggregate(history):
+    frame = build(history, history["timestamp"])
+    assert frame.columns.tolist() == ["card_chargeback_rate"]
+    assert len(frame) == len(history)
+    assert np.isfinite(frame.to_numpy(dtype=float)).all()
