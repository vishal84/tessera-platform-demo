@@ -0,0 +1,183 @@
+"""
+Gate 3 -- drift between the training distribution and recent traffic.
+
+    uv run python -m ml.validation.drift --max-psi 0.25
+
+Population Stability Index per feature, reference = the training window,
+current = the most recent traffic (here the scored window; in production this
+reads served feature values out of the feature store for the same period).
+The usual reading: below 0.10 stable, 0.10-0.25 worth watching, above 0.25 the
+model is being asked about a population it was not trained on.
+
+PSI is computed over quantile bins of the *reference*, and the binning is
+deliberately spike-aware. Most fraud features are mostly zero --
+`card_chargeback_rate` is zero for 96.6% of training rows -- and naive
+`histogram` edges put the entire point mass and everything above it in one
+bin, which reports 0.000 drift for a feature whose non-zero share quadrupled.
+A gate that cannot see the one feature it most needs to watch is worse than no
+gate.
+
+What this gate cannot see: train/serve skew. A feature computed one way in
+training and another way at serving time shows up here as drift only by
+accident, and in the fraud-v3 shadow run it did not -- the population had not
+changed, the feature definition had. That is Gate 1's job, and the reason
+Gate 1 runs first.
+"""
+
+from __future__ import annotations
+
+import argparse
+from dataclasses import dataclass
+
+import numpy as np
+import pandas as pd
+
+from ml.validation import candidate
+from ml.validation.dataset import add_data_argument, load_transactions, temporal_split
+
+DEFAULT_MAX_PSI = 0.25
+DEFAULT_BINS = 10
+EPSILON = 1e-6
+
+
+@dataclass(frozen=True)
+class FeatureDrift:
+    feature: str
+    psi: float
+    bins: int
+    reference_mean: float
+    current_mean: float
+
+    @property
+    def band(self) -> str:
+        if self.psi < 0.10:
+            return "stable"
+        return "watch" if self.psi < DEFAULT_MAX_PSI else "significant"
+
+
+@dataclass(frozen=True)
+class DriftReport:
+    features: tuple[FeatureDrift, ...]
+    n_reference: int
+    n_current: int
+    window: str
+    maximum: float
+
+    @property
+    def worst(self) -> FeatureDrift:
+        return max(self.features, key=lambda f: f.psi)
+
+    @property
+    def passed(self) -> bool:
+        return all(f.psi <= self.maximum for f in self.features)
+
+
+def bin_edges(reference: np.ndarray, bins: int = DEFAULT_BINS) -> np.ndarray:
+    """
+    Interior cut points from the reference distribution.
+
+    Bin `i` is the half-open interval `(edge[i-1], edge[i]]`, so a value
+    sitting exactly on a cut point falls in the lower bin -- which is what
+    keeps a point mass at zero in a bin of its own.
+    """
+    quantiles = np.unique(np.nanquantile(reference, np.linspace(0, 1, bins + 1)))
+    interior = quantiles[1:-1]
+    if interior.size:
+        return interior
+
+    distinct = np.unique(reference[~np.isnan(reference)])
+    return distinct[:1] if distinct.size > 1 else np.array([])
+
+
+def population_stability_index(
+    reference: np.ndarray, current: np.ndarray, bins: int = DEFAULT_BINS
+) -> tuple[float, int]:
+    """PSI of `current` against `reference`, plus the number of bins used."""
+    edges = bin_edges(reference, bins)
+    if edges.size == 0 or reference.size == 0 or current.size == 0:
+        return 0.0, 1
+
+    n_bins = edges.size + 1
+    reference_share = np.bincount(np.searchsorted(edges, reference, side="left"), minlength=n_bins)
+    current_share = np.bincount(np.searchsorted(edges, current, side="left"), minlength=n_bins)
+
+    expected = np.clip(reference_share / reference.size, EPSILON, None)
+    actual = np.clip(current_share / current.size, EPSILON, None)
+    return float(np.sum((actual - expected) * np.log(actual / expected))), n_bins
+
+
+def run(
+    df: pd.DataFrame, maximum: float = DEFAULT_MAX_PSI, bins: int = DEFAULT_BINS
+) -> DriftReport:
+    features = candidate.build_features(df)
+    split = temporal_split(df)
+    reference, current = features.loc[split.train.index], features.loc[split.test.index]
+
+    measured = []
+    for name in features.columns:
+        left = reference[name].to_numpy(dtype=float)
+        right = current[name].to_numpy(dtype=float)
+        psi, n_bins = population_stability_index(left, right, bins)
+        measured.append(
+            FeatureDrift(
+                feature=name,
+                psi=psi,
+                bins=n_bins,
+                reference_mean=float(np.nanmean(left)),
+                current_mean=float(np.nanmean(right)),
+            )
+        )
+
+    return DriftReport(
+        features=tuple(measured),
+        n_reference=len(reference),
+        n_current=len(current),
+        window=split.window,
+        maximum=maximum,
+    )
+
+
+def format_report(report: DriftReport) -> str:
+    lines = [
+        "Gate 3 -- drift, training vs recent traffic",
+        f"  reference: {report.n_reference:,} training rows",
+        f"  current  : {report.n_current:,} rows, {report.window}",
+        "",
+        f"  {'feature':<28} {'PSI':>8}  {'bins':>4}  {'ref mean':>10}  {'cur mean':>10}  band",
+    ]
+    for feature in sorted(report.features, key=lambda f: f.psi, reverse=True):
+        lines.append(
+            f"  {feature.feature:<28} {feature.psi:>8.4f}  {feature.bins:>4}  "
+            f"{feature.reference_mean:>10.4f}  {feature.current_mean:>10.4f}  {feature.band}"
+        )
+
+    worst = report.worst
+    lines += ["", f"  {'PASS' if report.passed else 'FAIL'} -- worst PSI {worst.psi:.4f} "
+              f"({worst.feature}), ceiling {report.maximum:.4f}"]
+    return "\n".join(lines)
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description="Gate 3: drift against recent traffic.")
+    add_data_argument(parser)
+    parser.add_argument(
+        "--max-psi",
+        type=float,
+        default=DEFAULT_MAX_PSI,
+        help=f"PSI ceiling for any single feature (default {DEFAULT_MAX_PSI})",
+    )
+    parser.add_argument("--bins", type=int, default=DEFAULT_BINS, help="reference quantile bins")
+    args = parser.parse_args(argv)
+
+    report = run(load_transactions(args.data), maximum=args.max_psi, bins=args.bins)
+    print(format_report(report))
+
+    if not report.passed:
+        drifted = [f"{f.feature} ({f.psi:.4f})" for f in report.features if f.psi > report.maximum]
+        print(f"\n::error::PSI above {report.maximum:.4f}: {', '.join(drifted)}")
+        return 1
+    return 0
+
+
+if __name__ == "__main__":  # pragma: no cover
+    raise SystemExit(main())
