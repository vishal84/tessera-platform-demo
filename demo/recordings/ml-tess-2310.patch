+"""Gate 2 tests."""
+
+from __future__ import annotations
+
+import pytest
+
+from ml.validation import performance
+from ml.validation.dataset import temporal_split
+
+
+@pytest.fixture(scope="module")
+def repo_report(repo_data):
+    """One fit, reused -- this is the expensive fixture in the suite."""
+    return performance.run(repo_data)
+
+
+def test_the_candidate_clears_the_ci_floor(repo_report):
+    assert repo_report.passed
+    assert repo_report.pr_auc >= performance.DEFAULT_MIN_PR_AUC
+
+
+def test_the_honest_number_is_nowhere_near_the_offline_claim(repo_report):
+    """
+    Notebook 01 recorded PR-AUC 0.358 for this feature set. That number was
+    leakage; point-in-time it is around 0.16, level with the champion. If this
+    assertion ever fails upwards, a leak has come back.
+    """
+    assert repo_report.pr_auc < 0.25
+    assert repo_report.auc < 0.85
+
+
+def test_metrics_are_reported_against_the_scored_window(repo_report, repo_data):
+    split = temporal_split(repo_data)
+    assert repo_report.n_train == len(split.train)
+    assert repo_report.n_test == len(split.test)
+    assert repo_report.window == split.window
+
+
+def test_a_floor_above_the_score_fails_the_gate(small_data):
+    report = performance.run(small_data, minimum=0.99)
+    assert not report.passed
+    assert "FAIL" in performance.format_report(report)
+
+
+def test_cli_exits_non_zero_below_the_floor(small_data_path, capsys):
+    assert performance.main(["--data", str(small_data_path), "--min-pr-auc", "0.99"]) == 1
+    assert "below the floor" in capsys.readouterr().out
+
+
+def test_cli_exits_zero_above_the_floor(small_data_path, capsys):
+    assert performance.main(["--data", str(small_data_path), "--min-pr-auc", "0.0"]) == 0
+    assert "PASS" in capsys.readouterr().out
