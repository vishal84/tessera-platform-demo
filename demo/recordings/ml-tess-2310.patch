+    assert (point_in_time.loc[split.train.index] > 0).mean() == pytest.approx(0.0344, abs=5e-5)
+    assert (point_in_time.loc[split.test.index] > 0).mean() == pytest.approx(0.1419, abs=5e-5)
+    assert NOTEBOOK_SOURCE.startswith("ml/notebooks/01_fraud_exploration.ipynb")
+
+
+def test_the_leaky_feature_is_the_label_in_disguise(repo_data):
+    """`chargeback_filed_at` is non-null on fraud rows and nowhere else."""
+    disputed = repo_data["chargeback_filed_at"].notna()
+    assert repo_data.loc[disputed, "is_fraud"].eq(1).all()
+    assert repo_data.loc[disputed, "is_fraud"].sum() < repo_data["is_fraud"].sum()
