index 0000000..1c858aa
--- /dev/null
+++ b/ml/features/aggregates.py
@@ -0,0 +1,171 @@
+"""
+Point-in-time historical aggregates.
+
+Unlike `ml/features/base.py`, nothing in this module is a pure function of one
+row. Every feature here summarises *history*, which makes it the dangerous
+kind: the training table has the whole timeline in it and a `groupby` will
+happily average over the future.
+
+That is not hypothetical. `card_chargeback_rate` as written in
+`ml/notebooks/01_fraud_exploration.ipynb` cell 8 --
+
+    df.groupby("card_token").chargeback_filed_at.apply(lambda s: s.notna().mean())
+
+-- has no as-of cut, so every training row is handed chargebacks filed after
+it, including the one for that very transaction. `chargeback_filed_at` is
+non-null on fraud rows only and lands 20-89 days later (median 54), so the
+column is the label in disguise. Offline that scored AUC 0.906; in shadow,
+served point-in-time, it scored 0.699 against a champion's 0.778. Recomputed
+honestly the feature is worth -0.0007 AUC (TESS-2310; see
+`ml/notebooks/03_v3_shadow_investigation.ipynb` and `ml/fraud/MODEL_CARD.md`).
+
+The rule this module encodes: **every aggregate takes an explicit `as_of` and
+counts only events that had already happened at that instant.** `as_of` has no
+default, for the same reason `ml/profiles/segments.py` gives it none.
+
+Two ways to pass it:
+
+* a **scalar** -- one cutoff for every row. This is how the nightly
+  `card_history` batch serves the feature: one refresh time for the whole
+  scoring batch.
+* a **per-row series** -- typically ``df["timestamp"]``, i.e. each row as of
+  its own scoring moment. This is how a training table is built.
+
+`ml.validation.leakage` (Gate 1) checks both properties mechanically: values
+must not move when future rows are dropped, and must not move when
+not-yet-filed chargebacks are censored.
+"""
+
+from __future__ import annotations
+
+from collections.abc import Callable
+
+import numpy as np
+import pandas as pd
+
+__all__ = ["AGGREGATE_FEATURES", "build", "card_chargeback_rate"]
+
+AsOf = pd.Timestamp | pd.Series | np.ndarray | str
+
+
+def _require_columns(df: pd.DataFrame, columns: tuple[str, ...]) -> None:
+    missing = [c for c in columns if c not in df.columns]
+    if missing:
+        raise ValueError(
+            f"point-in-time aggregate needs {sorted(missing)}; "
+            "a frame without dispute history cannot produce this feature"
+        )
+
+
+def _epochs(values: pd.Series) -> np.ndarray:
+    """Datetimes as int64 nanoseconds. NaT keeps pandas' iNaT sentinel."""
+    return pd.to_datetime(values, utc=True).to_numpy(dtype="datetime64[ns]").astype("int64")
+
+
+def _as_of_epochs(df: pd.DataFrame, as_of: AsOf) -> np.ndarray:
+    """Normalise `as_of` -- scalar or per-row -- to one int64 instant per row."""
+    if isinstance(as_of, (pd.Series, np.ndarray, list)):
+        values = pd.Series(np.asarray(as_of))
+        if len(values) != len(df):
+            raise ValueError(
+                f"as_of has {len(values)} entries for {len(df)} rows; "
+                "pass one instant per row or a single scalar cutoff"
+            )
+    else:
+        values = pd.Series([as_of] * len(df))
+
+    stamps = pd.to_datetime(values, utc=True)
+    if stamps.isna().any():
+        raise ValueError("as_of contains NaT; every row needs a scoring instant")
+    return stamps.to_numpy(dtype="datetime64[ns]").astype("int64")
+
+
+def _count_strictly_before(
+    event_codes: np.ndarray,
+    event_times: np.ndarray,
+    query_codes: np.ndarray,
+    query_times: np.ndarray,
+) -> np.ndarray:
+    """
+    For each query `(code, t)`, how many events share that code and happened
+    strictly before `t`.
+
+    Both sides fold into one sortable int64 key, ``code * M + rank(time)``,
+    where `M` exceeds every rank -- so keys never collide across codes, each
+    code's events form one contiguous block, and a single pair of
+    `searchsorted` calls answers every row at once. The alternative, a Python
+    loop over cards, is the version that stops finishing when the table is
+    real.
+
+    `searchsorted(..., side="left")` is what makes the bound strict: an event
+    at exactly `t` is not yet observable at `t`.
+    """
+    n_queries = query_times.shape[0]
+    if event_times.size == 0:
+        return np.zeros(n_queries, dtype=np.int64)
+
+    universe = np.unique(np.concatenate([event_times, query_times]))
+    stride = np.int64(universe.size + 1)
+
+    keys = np.sort(event_codes.astype(np.int64) * stride + np.searchsorted(universe, event_times))
+    block_start = query_codes.astype(np.int64) * stride
+    starts = np.searchsorted(keys, block_start, side="left")
+    ends = np.searchsorted(keys, block_start + np.searchsorted(universe, query_times), side="left")
+    return ends - starts
+
+
+def card_chargeback_rate(df: pd.DataFrame, as_of: AsOf) -> pd.Series:
+    """
+    Share of a card's transactions that were already disputed at `as_of`.
+
+    For every row: the number of chargebacks on that card **filed** strictly
+    before `as_of`, over the number of that card's transactions that had
+    **happened** strictly before `as_of`. A card with no history at that
+    instant scores 0.0 -- it is a genuinely empty denominator, not a missing
+    value, and the model should read it as "nothing known yet".
+
+    Requires `card_token`, `timestamp` and `chargeback_filed_at`.
+
+    >>> rate = card_chargeback_rate(df, df["timestamp"])   # training table
+    >>> rate = card_chargeback_rate(df, "2026-09-20T00:00:00Z")  # batch refresh
+
+    Both bounds are strict, so the row being scored can never count itself and
+    ties in `timestamp` cannot change the answer -- the result does not depend
+    on row order, which the notebook version did.
+    """
+    _require_columns(df, ("card_token", "timestamp", "chargeback_filed_at"))
+    name = "card_chargeback_rate"
+    if df.empty:
+        return pd.Series(np.zeros(0), index=df.index, dtype=float, name=name)
+
+    instants = _as_of_epochs(df, as_of)
+    codes = pd.factorize(df["card_token"], use_na_sentinel=False)[0]
+    filed = df["chargeback_filed_at"]
+    disputed = filed.notna().to_numpy()
+
+    prior_txns = _count_strictly_before(codes, _epochs(df["timestamp"]), codes, instants)
+    prior_chargebacks = _count_strictly_before(
+        codes[disputed], _epochs(filed[disputed]), codes, instants
+    )
+
+    rate = np.divide(
+        prior_chargebacks,
+        prior_txns,
+        out=np.zeros(len(df), dtype=float),
+        where=prior_txns > 0,
+    )
+    return pd.Series(rate, index=df.index, name=name)
+
+
+# Every aggregate here takes (frame, as_of) and returns one column. Gate 1
+# walks this registry, so a feature added here is a feature that gets checked.
+AGGREGATE_FEATURES: dict[str, Callable[[pd.DataFrame, AsOf], pd.Series]] = {
+    "card_chargeback_rate": card_chargeback_rate,
+}
+
+
+def build(df: pd.DataFrame, as_of: AsOf) -> pd.DataFrame:
+    """Assemble every historical aggregate as of `as_of`."""
+    return pd.DataFrame(
+        {name: fn(df, as_of) for name, fn in AGGREGATE_FEATURES.items()}, index=df.index
+    )
