@@ -0,0 +1,77 @@
+"""Gate 3 tests."""
+
+from __future__ import annotations
+
+import numpy as np
+import pytest
+
+from ml.validation import drift
+
+
+@pytest.fixture(scope="module")
+def repo_report(repo_data):
+    return drift.run(repo_data)
+
+
+def test_identical_distributions_have_no_drift():
+    values = np.random.default_rng(0).normal(size=5_000)
+    psi, _ = drift.population_stability_index(values, values.copy())
+    assert psi == pytest.approx(0.0, abs=1e-9)
+
+
+def test_a_shifted_distribution_breaches_the_ceiling():
+    rng = np.random.default_rng(0)
+    reference = rng.normal(size=5_000)
+    current = rng.normal(loc=1.5, size=5_000)
+    psi, _ = drift.population_stability_index(reference, current)
+    assert psi > drift.DEFAULT_MAX_PSI
+
+
+def test_a_spike_at_zero_is_measured_rather_than_swallowed():
+    """
+    The failure mode this binning exists to avoid: a feature that is mostly
+    zero, whose non-zero share quadruples, must not report 0.000 drift.
+    """
+    reference = np.concatenate([np.zeros(9_600), np.full(400, 0.5)])
+    current = np.concatenate([np.zeros(8_600), np.full(1_400, 0.5)])
+    psi, bins = drift.population_stability_index(reference, current)
+    assert bins >= 2
+    assert psi > 0.1
+
+
+def test_a_constant_feature_does_not_blow_up():
+    psi, bins = drift.population_stability_index(np.ones(100), np.ones(100))
+    assert (psi, bins) == (0.0, 1)
+
+
+def test_every_shipped_feature_is_measured(repo_report):
+    from ml.validation.candidate import FEATURE_ORDER
+
+    assert {f.feature for f in repo_report.features} == set(FEATURE_ORDER)
+
+
+def test_the_repo_data_passes_the_ci_ceiling(repo_report):
+    assert repo_report.passed
+    assert repo_report.worst.psi <= drift.DEFAULT_MAX_PSI
+
+
+def test_card_history_is_the_feature_that_moves(repo_report):
+    """
+    Cards accumulate history as the timeline runs, so the point-in-time
+    chargeback rate is non-zero four times as often in the scored window as in
+    training. That is a real cold-start effect, not a population change, and
+    the gate should surface it rather than hide it.
+    """
+    assert repo_report.worst.feature == "card_chargeback_rate"
+    assert repo_report.worst.psi > 0.1
+    assert repo_report.worst.band == "watch"
+
+
+def test_cli_fails_when_the_ceiling_is_impossible(small_data_path, capsys):
+    assert drift.main(["--data", str(small_data_path), "--max-psi", "0.0"]) == 1
+    assert "PSI above" in capsys.readouterr().out
+
+
+def test_cli_passes_at_the_ci_ceiling(small_data_path, capsys):
+    assert drift.main(["--data", str(small_data_path), "--max-psi", "0.25"]) == 0
+    assert "PASS" in capsys.readouterr().out
