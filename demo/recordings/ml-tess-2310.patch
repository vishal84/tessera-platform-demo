+"""Gate 4 tests."""
+
+from __future__ import annotations
+
+import pytest
+
+from ml.validation import fairness
+
+
+@pytest.fixture(scope="module")
+def report(small_data):
+    return fairness.run(small_data)
+
+
+def test_every_dimension_is_sliced(report):
+    assert {s.dimension for s in report.slices} == {
+        "geography",
+        "cross_border",
+        "mcc_risk_tier",
+        "amount_band",
+        "time_of_day",
+    }
+
+
+def test_rates_are_reported_per_slice_not_in_aggregate(report):
+    assert len(report.slices) > len({s.dimension for s in report.slices})
+    for measured in report.slices:
+        assert 0.0 <= measured.alert_rate <= 1.0
+        assert 0.0 <= measured.fraud_rate <= 1.0
+
+
+def test_the_operating_point_matches_the_review_budget(report, small_data):
+    """Roughly the top 1% of the scored window, however the slices fall."""
+    scored = sum(s.n for s in report.slices if s.dimension == "geography")
+    alerts = sum(s.n * s.alert_rate for s in report.slices if s.dimension == "geography")
+    assert alerts / scored == pytest.approx(fairness.REVIEW_BUDGET, abs=2e-3)
+
+
+def test_slices_too_small_to_measure_are_kept_but_blanked(report):
+    for measured in report.slices:
+        if not measured.measurable:
+            assert measured.tpr is None and measured.pr_auc is None
+
+
+def test_disparity_is_computed_per_dimension(report):
+    assert {d.dimension for d in report.disparities} <= {s.dimension for s in report.slices}
+    for spread in report.disparities:
+        assert spread.ratio >= 1.0
+
+
+def test_the_report_is_written_as_markdown(small_data_path, tmp_path, capsys):
+    destination = tmp_path / "nested" / "fairness.md"
+    assert fairness.main(["--data", str(small_data_path), "--report", str(destination)]) == 0
+
+    written = destination.read_text(encoding="utf-8")
+    assert written.startswith("# Fairness slice report")
+    for dimension in ("geography", "amount_band", "time_of_day", "mcc_risk_tier"):
+        assert f"## {dimension}" in written
+    assert "no protected-class attributes" in written
+    assert "report written to" in capsys.readouterr().out
+
+
+def test_the_gate_reports_without_blocking_by_default(report):
+    assert report.max_disparity is None
+    assert report.passed
+
+
+def test_max_disparity_makes_it_blocking(small_data_path, tmp_path, capsys):
+    """A fraud model concentrates its alerts by design; 1.0x is unreachable."""
+    exit_code = fairness.main(
+        [
+            "--data",
+            str(small_data_path),
+            "--report",
+            str(tmp_path / "fairness.md"),
+            "--max-disparity",
+            "1.0",
+        ]
+    )
+    assert exit_code == 1
+    assert "alert-rate disparity" in capsys.readouterr().out
diff --git a/ml/validation/tests/test_leakage.py b/ml/validation/tests/test_leakage.py
new file mode 100644
index 0000000..d4b3ccc
--- /dev/null
+++ b/ml/validation/tests/test_leakage.py
@@ -0,0 +1,143 @@
+"""
+Gate 1 tests.
+
+Half of these check that the shipped feature set passes. The other half check
+that the gate fails on `negative_fixtures.card_chargeback_rate_whole_table` --
+the definition from notebook 01 that reached shadow. A gate nobody has watched
+fail is a gate nobody should trust.
+"""
+
+from __future__ import annotations
+
+import pandas as pd
+import pytest
+
+from ml.features.aggregates import card_chargeback_rate
+from ml.validation import leakage
+from ml.validation.dataset import temporal_split
+from ml.validation.tests.negative_fixtures import (
+    NOTEBOOK_SOURCE,
+    card_chargeback_rate_whole_table,
+    notebook_feature_set,
+    reads_the_label,
+)
+
+
+def _verdicts(results: list[leakage.CheckResult]) -> dict[str, bool]:
+    return {result.check: result.leaked for result in results}
+
+
+# --- the shipped feature set ------------------------------------------------
+
+
+def test_every_shipped_feature_passes_every_check(small_data):
+    report = leakage.run(small_data)
+    assert report.clean, [r.detail for r in report.leaks]
+
+
+def test_the_point_in_time_aggregate_is_checked_for_future_rows(small_data):
+    report = leakage.run(small_data)
+    checks = {(r.feature, r.check) for r in report.results}
+    assert ("card_chargeback_rate", "future_rows") in checks
+    assert ("card_chargeback_rate", "outcome_censoring") in checks
+
+
+def test_gate_passes_on_the_shipped_feature_set(small_data_path, capsys):
+    assert leakage.main(["--fail-on-leak", "--data", str(small_data_path)]) == 0
+    assert "PASS" in capsys.readouterr().out
+
+
+def test_frame_statistics_are_named_rather_than_silently_skipped(small_data):
+    """
+    base.amount_zscore_within_mcc standardises against a whole-frame mean, so
+    it is exempt from the future-rows check. The report has to say so.
+    """
+    report = leakage.run(small_data)
+    assert "amount_zscore_within_mcc" in report.exempt_from_future_rows
+    assert "amount_zscore_within_mcc" in leakage.format_report(report)
+
+
+# --- the notebook definition ------------------------------------------------
+
+
+def test_the_notebook_definition_is_caught_by_outcome_censoring(small_data):
+    feature = notebook_feature_set()[0]
+    results = leakage.check_feature(feature, small_data, temporal_split(small_data).cut)
+    assert _verdicts(results)["outcome_censoring"] is True
+
+
+def test_the_notebook_definition_is_caught_by_future_rows(small_data):
+    feature = notebook_feature_set()[0]
+    results = leakage.check_feature(feature, small_data, temporal_split(small_data).cut)
+    assert _verdicts(results)["future_rows"] is True
+
+
+def test_the_notebook_definition_survives_label_permutation(small_data):
+    """
+    It reads `chargeback_filed_at`, not `is_fraud`, so the cheap check clears
+    it. That is why the censoring check exists -- and why this gate runs all
+    three rather than the obvious one.
+    """
+    feature = notebook_feature_set()[0]
+    results = leakage.check_feature(feature, small_data, temporal_split(small_data).cut)
+    assert _verdicts(results)["label_permutation"] is False
+
+
+def test_gate_one_fails_on_the_notebook_definition(small_data_path, monkeypatch, capsys):
+    """The contract from model-validation.yml: --fail-on-leak must exit non-zero."""
+    monkeypatch.setattr(leakage, "production_features", notebook_feature_set)
+
+    assert leakage.main(["--fail-on-leak", "--data", str(small_data_path)]) == 1
+    output = capsys.readouterr().out
+    assert "LEAK" in output
+    assert "card_chargeback_rate" in output
+
+
+def test_without_the_flag_a_leak_is_reported_but_not_blocking(small_data_path, monkeypatch):
+    """`--fail-on-leak` is what makes it a gate; without it the module reports."""
+    monkeypatch.setattr(leakage, "production_features", notebook_feature_set)
+    assert leakage.main(["--data", str(small_data_path)]) == 0
+
+
+def test_label_permutation_catches_a_feature_that_reads_the_label(small_data):
+    feature = leakage.FeatureUnderTest("reads_the_label", reads_the_label, historical=False)
+    results = leakage.check_feature(feature, small_data, temporal_split(small_data).cut)
+    assert _verdicts(results)["label_permutation"] is True
+
+
+def test_a_feature_that_cannot_be_recomputed_is_not_cleared(small_data):
+    def explodes(frame: pd.DataFrame) -> pd.Series:
+        raise RuntimeError("no")
+
+    report = leakage.run(
